+.dialog {
+  position: fixed; inset: 0; margin: auto; padding: 0; border: 0; border-radius: 2px;
+  width: min(600px, calc(100vw - 28px)); max-height: calc(100dvh - 28px);
+  background: #fbfaf7; color: #19181b; overflow-y: auto; overscroll-behavior: contain;
+  font: 400 16px/1.5 var(--font-sans); text-align: left;
+}
+.dialog::backdrop { background: rgb(18 17 15 / .61); backdrop-filter: blur(5px); }
+:global(html):has(.dialog[open]) { overflow: hidden; }
+.panel { position: relative; padding: clamp(24px, 4vw, 51px); }
+.close { position: absolute; top: clamp(24px, 4vw, 51px); right: clamp(24px, 4vw, 51px); width: 44px; height: 44px; border-radius: 50%; border: 1px solid #c9c7c2; font: 300 25px/1 var(--font-sans); }
+.eyebrow, .always, .actions button { font-weight: 600; text-transform: uppercase; letter-spacing: .23em; }
+.eyebrow, .always { font-size: 10px; color: #625f67; }
+.eyebrow::before { content: ""; display: block; width: 38px; height: 1px; background: #595650; margin-bottom: 16px; }
+.panel h2 { font: 400 clamp(30px, 5vw, 39px)/1.15 var(--font-serif); margin: 9px 25px 10px 0; }
+.intro, .row p { color: #776b58; }
+.intro { max-width: 420px; margin-bottom: 29px; font-size: 15px; }
+.row { display: flex; align-items: flex-start; justify-content: space-between; gap: 14px; border-top: 1px solid #dedbd5; padding: 20px 0; }
+.row p { font-size: 14px; margin: 6px 0 0; }
+.always { white-space: nowrap; margin-top: 3px; }
+.toggle { flex: 0 0 50px; height: 29px; margin-top: 8px; padding: 4px; border-radius: 18px; background: #77746f; }
+.toggle::after { content: ""; display: block; border-radius: 50%; width: 21px; height: 21px; background: white; transition: transform .15s; }
+.toggle[aria-checked="true"] { background: #19181b; }
+.toggle[aria-checked="true"]::after { transform: translateX(21px); }
+.actions { border-top: 1px solid #dedbd5; padding-top: 28px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
+.actions button { padding: 14px 6px; border: 1px solid #aaa7a2; min-height: 52px; font-size: 12px; }
+.actions button:last-child { background: #19181b; color: white; border-color: #19181b; }
+.policy { display: block; text-align: center; font-size: 13px; color: #656369; margin-top: 16px; }
+.policy:hover { text-decoration: underline; }
+@media (max-width: 420px) { .actions { grid-template-columns: 1fr; } }
